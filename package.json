{
  "name": "css-variable-lsp",
  "version": "2.0.0",
  "description": "A CSS Language Server for CSS Variables",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmn451/css-lsp"
  },
  "bin": {
    "css-variable-lsp": "out/server.js"
  },
  "scripts": {
    "compile": "tsc -b",
    "pretest": "npm run compile",
    "prepack": "npm run compile",
    "test:package": "node scripts/smoke-package.cjs",
    "perf": "CSS_LSP_PERF=1 TS_NODE_PROJECT=tsconfig.test.json node --test --require ts-node/register tests/perf.test.ts",
    "watch": "tsc -b -w",
    "test": "TS_NODE_PROJECT=tsconfig.test.json node --test --test-concurrency=2 --require ts-node/register tests/*.test.ts"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.20.5",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "css-tree": "^3.2.1",
    "glob": "^14.0.4",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16",
    "vscode-uri": "^3.2.0",
    "node-html-parser": "^9.0.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.0.2"
}
